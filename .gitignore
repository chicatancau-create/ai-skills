# ---- EXCLUDED FROM REMOTE BACKUP: licence forbids redistribution ----
# See BACKUP_SCOPE.md for the full reasoning and how to re-obtain each one.
# These stay on disk and keep working; they are simply never pushed.
/docx/
/pdf/
/pptx/
/xlsx/
/reverse-trace/
/reverse-wechat-miniapp/
/webapp-building/

# ---- WorkBuddy app state written into the skill root (not skill content) ----
# These are mutable migration markers the app rewrites; backing them up would
# churn the repo and they are meaningless on another machine.
.disable_to_model_invocation_migration.json
.model_invocation_to_override_migration.json
_bm_skillid_migration.json
